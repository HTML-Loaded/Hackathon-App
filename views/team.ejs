
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= team.teamName %> | RGV Hackathon</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/partials.css">
    <link rel="stylesheet" href="/css/team.css">
</head>
<body>
    <%- include("./partials/navbar.ejs") %>

    <main id="team-page">
        <div class="team-panel">

            <div class="team-header">
                <div class="team-heading">
                    <h1><%= team.teamName %></h1>
                    <p>
                        <%= isMember ? "Your Team" : "Hackathon Team" %>
                    </p>
                </div>

                
                <div class="team-actions">
                    <% if (isMember) { %>
                        <a href="/teams/<%= team.id %>/edit" class="team-btn">
                            Edit Team
                        </a>
                    <% } else if (hasApplied) { %>
                        <button class="team-btn" disabled>
                            Applied
                        </button>
                    <% } else if (currentUser && currentUser.teamId === 0) { %>
                        <form action="/teams/<%= team.id %>/apply" method="POST">
                            <button type="submit" class="team-btn">
                                Apply to Team
                            </button>
                        </form>
                    <% } %>

                    <% if (currentUser && currentUser.teamId === team.id) { %>
                                <a href="/projects" class="project-link team-btn">
                            View / Submit Project
                        </a>
                    <% } %>
                </div>

            </div>

            <section class="team-section">
                <h2>About the Team</h2>
                <p class="team-description">
                    <%= team.description || "No description provided." %>
                </p>
            </section>

            <section class="team-section">
                <h2>Team Members</h2>

                <% if (members && members.length > 0) { %>
                    <div class="team-member-list">
                        <% members.forEach(member => { %>
                            <a
                                href="/user/<%= member.id %>"
                                class="team-member"
                            >
                                <img
                                    src="<%= member.profilePicture || '/images/default-profile.png' %>"
                                    alt="<%= member.name %>'s profile picture"
                                    class="team-member-image"
                                >

                                <div class="team-member-info">
                                    <h3><%= member.name %></h3>
                                    <p>
                                        <%= member.skills?.length
                                            ? member.skills.join(", ")
                                            : "No skills listed" %>
                                    </p>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p>No members listed.</p>
                <% } %>
            </section>

            
            <% if (isMember) { %>
                <section class="team-section team-private">
                    <h2>Team Applications</h2>

                    <% if (applicants.length > 0) { %>
                        <div class="team-member-list">
                            <% applicants.forEach(applicant => { %>
                                <div class="team-applicant">
                                    <a
                                        href="/user/<%= applicant.id %>"
                                        class="team-applicant-info"
                                    >
                                        <img
                                            src="<%= applicant.profilePicture || '/images/default-profile.png' %>"
                                            alt="Profile picture"
                                            class="team-member-image"
                                        >

                                        <div class="team-member-info">
                                            <h3><%= applicant.name %></h3>
                                            <p>
                                                <%= applicant.skills?.join(", ") || "No skills listed" %>
                                            </p>
                                        </div>
                                    </a>

                                    <form
                                        action="/teams/<%= team.id %>/approve/<%= applicant.id %>"
                                        method="POST"
                                    >
                                        <button type="submit" class="team-btn">
                                            Approve
                                        </button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p>No pending applications.</p>
                    <% } %>
                </section>
            <% } %>


            <div class="team-footer">
                <a href="/teams" class="team-back-link">
                    Back to Teams
                </a>
            </div>

        </div>
    </main>

    <%- include("./partials/footer.ejs") %>
</body>
</html>
