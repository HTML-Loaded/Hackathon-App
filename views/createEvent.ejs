
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Event | RGV Hackathon</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/partials.css">
    <link rel="stylesheet" href="/css/events.css">
</head>
<body>
    <%- include("./partials/navbar.ejs") %>

    <main class="events-page">
        <div class="create-event-panel">
            <h1>Create an Event</h1>

            <p>
                Organize a workshop, activity, or competition
                during the RGV Hackathon.
            </p>

            <form action="/events/create" method="POST"
                class="create-event-form">

                <div class="event-form-field">
                    <label for="name">Event Name</label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="event-form-field">
                    <label for="description">Description</label>

                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        maxlength="2000"
                        required
                    ></textarea>
                </div>

                <div class="event-form-field">
                    <label for="locations">Location</label>

                    <select id="locations" name="locations" required>
                        <option value="">Select a room</option>
                        <option value="Room 204">Room 204</option>
                        <option value="Computer Lab 305">Computer Lab 305</option>
                        <option value="Conference Hall 202">Conference Hall 202</option>
                        <option value="Auditorium 101">Auditorium 101</option>
                    </select>
                </div>

                <div class="event-form-row">
                    <div class="event-form-field">
                        <label for="startDate">Event Day</label>

                        <select id="startDate" name="startDate" required>
                            <option value="2026-11-19">Day 1 - Nov 19</option>
                            <option value="2026-11-21">Day 3 - Nov 21</option>
                        </select>
                    </div>

                    <div class="event-form-field">
                        <label for="timestart">Start Time</label>

                        <input
                            type="time"
                            id="timestart"
                            name="timestart"
                            min="08:00"
                            max="20:00"
                            step="1800"
                            required
                        >
                    </div>
                </div>

                <p class="event-form-note">
                    Events last 1 hour. A 30-minute gap is required
                    between events using the same room.
                    Day 2 is reserved for the hackathon.
                </p>

                <h2>Event Images</h2>

                <p class="event-form-note">
                    Enter up to three image paths from your
                    public/images folder.
                </p>

                <div class="event-form-field">
                    <label for="img1">Image 1</label>
                    <input type="text" id="img1" name="img1"
                        placeholder="/images/events/example1.jpg">
                </div>

                <div class="event-form-field">
                    <label for="img2">Image 2</label>
                    <input type="text" id="img2" name="img2"
                        placeholder="/images/events/example2.jpg">
                </div>

                <div class="event-form-field">
                    <label for="img3">Image 3</label>
                    <input type="text" id="img3" name="img3"
                        placeholder="/images/events/example3.jpg">
                </div>

                <div class="create-event-actions">
                    <a href="/events" class="event-cancel-btn">
                        Cancel
                    </a>

                    <button type="submit" class="create-event-btn">
                        Create Event
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include("./partials/footer.ejs") %>
</body>
</html>
