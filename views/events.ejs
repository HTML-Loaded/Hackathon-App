
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Events | RGV Hackathon</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/partials.css">
    <link rel="stylesheet" href="/css/events.css">
    <script src="/js/events.js" defer></script> 
</head>
<body>
    <%- include("./partials/navbar.ejs") %>

    <main class="events-page">
        <header class="events-header">
            <h1>Hackathon Events</h1>
            <p>
                Explore workshops, competitions, and activities
                happening throughout the RGV Hackathon.
            </p>
        </header>

        <!-- Sliding day selector -->
        <div class="day-selector">
            <div class="day-slider"></div>

            <button type="button" class="day-btn active" data-day="2026-11-19">
                Day 1
                <span>Nov 19</span>
            </button>

            <button type="button" class="day-btn" data-day="2026-11-20">
                Day 2
                <span>Nov 20</span>
            </button>

            <button type="button" class="day-btn" data-day="2026-11-21">
                Day 3
                <span>Nov 21</span>
            </button>
        </div>

        <h2 id="selected-day-title">November 19 Events</h2>

        <!-- Event cards generated by JavaScript -->
        <section id="events-grid" class="events-grid"></section>

        <% if (currentUser) { %>
            <div class="events-footer">
            <a href="/events/create" class="create-event-btn">
                + Create Event
            </a>
        </div>
        <% } %>
    </main>

    <%- include("./partials/footer.ejs") %>

    <!-- Safely serialize server-side event data -->
    <script id="events-data" type="application/json"><%- JSON.stringify(events).replace(/</g, "\\u003c") %></script>
    <script id="current-user-data" type="application/json">
        <%- JSON.stringify(currentUser ? currentUser.id : null) %>
    </script>
</body>
</html>
