
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Team Project | RGV Hackathon</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/partials.css">
    <link rel="stylesheet" href="/css/project.css">
</head>
<body>
    <%- include("./partials/navbar.ejs") %>

    <main class="project-page">
        <h1>Team Project</h1>

        <% if (project) { %>
            <section class="submitted-project">
                <h2>Current Submission</h2>

                <h3><%= project.title %></h3>

                <p><%= project.description %></p>

                <p>
                    <strong>Repository:</strong>
                    <a href="<%= project.repositoryLink %>"
                        target="_blank" rel="noopener noreferrer">
                        View Repository
                    </a>
                </p>

                <p>
                    <strong>Last Submitted:</strong>
                    <%= new Date(project.submissionDate).toLocaleString() %>
                </p>
            </section>
        <% } %>

        <section class="project-form-section">
            <h2>
                <%= project ? "Edit Project" : "Submit Project" %>
            </h2>

            <form action="/projects" method="POST" class="project-form">

                <div>
                    <label for="title">Project Title</label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        maxlength="100"
                        value="<%= project ? project.title : '' %>"
                        required
                    >
                </div>

                <div>
                    <label for="description">Description</label>

                    <textarea
                        id="description"
                        name="description"
                        maxlength="2000"
                        rows="6"
                        required
                    ><%= project ? project.description : '' %></textarea>
                </div>

                <div>
                    <label for="repositoryLink">Repository Link</label>

                    <input
                        type="url"
                        id="repositoryLink"
                        name="repositoryLink"
                        placeholder="https://github.com/username/project"
                        value="<%= project ? project.repositoryLink : '' %>"
                        required
                    >
                </div>

                <button type="submit">
                    <%= project ? "Update Project" : "Submit Project" %>
                </button>
            </form>
        </section>

        <a href="/teams/<%= currentUser.teamId %>" class="back-to-team">
            Back to Team
        </a>
    </main>

    <%- include("./partials/footer.ejs") %>
</body>
</html>
