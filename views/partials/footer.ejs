<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>footer</title>
</head>
<!-- should have sponsors here -->
<body>
    
<footer class="site-footer">
    <div class="wrapper">

        <!-- Hackathon Information -->
        <div class="foot-col">
            <div class="logo">
                <a href="/home">
                    <img src="/images/palm.png" alt="RGV Hackathon Logo">
                </a>
            </div>

            <h3>RGV Hackathon</h3>
            <p>
                Bringing developers, designers, and innovators
                together in the Rio Grande Valley.
            </p>

            <p class="copyright">
                &copy; <%= new Date().getFullYear() %> RGV Hackathon.
                All rights reserved.
            </p>
        </div>

        <!-- Site Navigation -->
        <div class="foot-col">
            <h3>Explore</h3>

            <ul class="foot-links">
                <li><a href="/home">Home</a></li>
                <li><a href="/home#about">About the Hackathon</a></li>
                <li><a href="/events">Event Schedule</a></li>
                <li><a href="/faq">FAQ</a></li>
                <li><a href="/user">My Profile</a></li>
            </ul>
        </div>

        <!-- Contact and Sponsorship -->
        <div class="foot-col">
            <h3>Get Involved</h3>

            <ul class="foot-links">
                <li><a href="/contact">Contact Us</a></li>
                <li><a href="/home#sponsor">Become a Sponsor</a></li>
                <li><a href="/teams">Join a Team</a></li>
            </ul>
        </div>

        <!-- Social Media -->
        <div class="foot-col">
            <h3>Follow Us</h3>

            <ul class="social-icons">
                <li>
                    <a href="https://www.facebook.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Facebook">
                        <img src="/images/icon-facebook.svg"
                             alt="Facebook">
                    </a>
                </li>

                <li>
                    <a href="https://x.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="X">
                        <img src="/images/icon-x.svg"
                             alt="X">
                    </a>
                </li>

                <li>
                    <a href="https://www.instagram.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Instagram">
                        <img src="/images/icon-instagram.svg"
                             alt="Instagram">
                    </a>
                </li>

                <li>
                    <a href="https://discord.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Discord">
                        <img src="/images/icon-discord.svg"
                             alt="Discord">
                    </a>
                </li>
            </ul>
        </div>

    </div>
</footer>

</body>
</html>