
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile | RGV Hackathon</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/user.css">
    <link rel="stylesheet" href="/css/partials.css">
</head>
<body>
    <%- include("./partials/navbar.ejs") %>

    <section id="user-profile">
        <div class="user-panel">

            <div class="user-header">
                <img
                    class="user-image"
                    src="<%= locals.user.profilePicture || '/images/default-profile.png' %>"
                    alt="Profile picture"
                >

                <div class="user-heading">
                    <h2><%= locals.user.name %></h2>
                    <p><%= locals.user.email %></p>
                </div>
            </div>

            <div class="user-details">
                <div class="user-field">
                    <h3>Roles</h3>
                    <p><%= locals.user.roles || 'No roles listed' %></p>
                </div>

                <div class="user-field">
                    <h3>Skills</h3>
                    <p><%= locals.user.skills || 'No skills listed' %></p>
                </div>

                <div class="user-field">
                    <h3>About Me</h3>
                    <p class="user-description"><%= locals.user.description || 'No description provided.' %></p>
                </div>
            </div>

            <div class="user-actions">
                <a href="/user/edit" class="user-edit-btn">Edit Profile</a>
            </div>

        </div>
    </section>

    <%- include("./partials/footer.ejs") %>
</body>
</html>
